# Postgres
PG_HOST=localhost
PG_PORT=5432
PG_USER=footprints
PG_PASSWORD=
PG_DB=footprints
PG_CONNECT_ATTEMPTS=10
PG_CONNECT_DELAY=3s

# API
API_HOST=0.0.0.0
API_PORT=8080

# Core: период опроса и шаг сетки времён коммитов (формат 10m, 30s)
CORE_TICK_INTERVAL=10m

# Auth: JWT_SECRET любая длинная строка, ENC_KEY ровно 32 байта в hex (64 символа)
AUTH_JWT_SECRET=
AUTH_ENC_KEY=
